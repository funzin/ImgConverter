{
  "name": "ImgConverter",
  "short_name": "ImgConverter",
  "version": "0.3.0",
  "description": "Converts Markdown image syntax to HTML img tags with optional width and height.",
  "manifest_version": 3,
  "minimum_chrome_version": "88",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "background": {
    "service_worker": "src/js/background.js"
  },
  "action": {
    "default_title": "convert",
    "default_icon": {
      "16": "resource/image/icons/16.png",
      "48": "resource/image/icons/48.png",
      "128": "resource/image/icons/128.png"
    }
  },
  "options_ui": {
    "page": "src/html/options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "resource/image/icons/16.png",
    "48": "resource/image/icons/48.png",
    "128": "resource/image/icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "@imgconverter",
      "strict_min_version": "109.0"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
