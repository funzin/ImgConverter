{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleDetection": "auto",
    "lib": ["ES2022", "DOM"],
    "types": ["chrome"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src/js/**/*.ts", "src/types/**/*.d.ts"]
}
